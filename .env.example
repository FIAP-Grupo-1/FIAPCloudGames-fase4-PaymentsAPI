# Copie para .env (que nunca vai para o git) e troque os valores.
# Nenhuma senha tem valor padrao no docker-compose.yml: sem o .env, o compose para e avisa.
POSTGRES_PASSWORD=troque-me
RABBITMQ_PASS=troque-me
REDIS_PASS=troque-me

# Opcional: publicar o PaymentProcessedEvent no SNS da AWS a partir da maquina local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
